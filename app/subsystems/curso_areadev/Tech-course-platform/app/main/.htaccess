<IfModule mod_rewrite.c>
    RewriteEngine On

    # Permitir acesso direto a arquivos existentes (imagens, css, js, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Redireciona tudo para index.php na pasta atual (app/main)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>